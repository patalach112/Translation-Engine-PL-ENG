# Copy this file to .env. Node 20+ loads it with --env-file.
HOST=0.0.0.0
PORT=8081

# Own local model via Ollama (no cloud API key or per-request provider quota).
TRANSLATION_BACKEND=ollama
OLLAMA_URL=http://127.0.0.1:11434
TRANSLATION_MODEL=qwen2.5:7b
TRANSLATION_TIMEOUT_MS=90000

# Bounded work protects a small host from overload.
MAX_CONCURRENT_TRANSLATIONS=2
MAX_QUEUED_TRANSLATIONS=16
REQUESTS_PER_MINUTE=120

# Alternative: OpenAI-compatible provider. This key stays server-side.
# TRANSLATION_BACKEND=openai-compatible
# TRANSLATION_BASE_URL=https://api.openai.com/v1
# TRANSLATION_API_KEY=
# TRANSLATION_MODEL=gpt-4o-mini
